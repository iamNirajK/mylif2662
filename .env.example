# REQUIRED: OpenRouter API Key (Only required AI secret - supports Free Models, Server-Side Only)
OPENROUTER_API_KEY=""

# OPTIONAL: OpenAI API Key (Not needed for zero-cost setup; adds OpenAI Chat, Whisper STT, Cloud TTS, Realtime)
OPENAI_API_KEY=""

# OPTIONAL: Custom OpenAI-Compatible Provider Base URL & Key
OPENAI_COMPATIBLE_BASE_URL=""
OPENAI_COMPATIBLE_API_KEY=""

# OPTIONAL: WeatherAPI.com Key (Enables live Current Weather, Forecast, Rain Probability & Astronomy tools)
WEATHERAPI_KEY=""

# OPTIONAL: Dedicated Voice Provider API Keys (Not needed for browser Web Speech / SpeechSynthesis)
STT_API_KEY=""
TTS_API_KEY=""
VOICE_PROVIDER_API_KEY=""

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="MY_APP_URL"

# VITE_GOOGLE_MAPS_API_KEY: Required for Google Maps Platform JavaScript SDK.
VITE_GOOGLE_MAPS_API_KEY="MY_GOOGLE_MAPS_API_KEY"
